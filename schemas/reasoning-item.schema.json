{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meridian21lab/cogito-mill/schemas/reasoning-item.schema.json",
  "title": "LongStoryShortPilotItem",
  "description": "Human-facing Hub schema for the Long Story Short pilot_v2 calibration pack.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable item id, e.g. lss-pilot-000123"
    },
    "story": {
      "type": "string",
      "minLength": 1,
      "description": "Self-contained narrative with dispersed evidence"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "Main uniquely answerable mystery question"
    },
    "gold_answer": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical final answer string for exact/normalized scoring"
    },
    "gold_answer_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "gold_answer": {"type": "string", "minLength": 1},
          "gold_answer_variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"type": "string", "minLength": 1}
          },
          "question_type": {
            "type": "string",
            "enum": ["main", "intermediate", "counterfactual", "code", "scalar"]
          }
        },
        "required": [
          "id",
          "question",
          "gold_answer",
          "gold_answer_variants",
          "question_type"
        ]
      }
    },
    "n_hops": {
      "type": "integer",
      "minimum": 1,
      "description": "Structural hop count of the intended successful proof"
    },
    "setting_family": {
      "type": "string",
      "enum": [
        "detective",
        "domestic",
        "workplace",
        "expedition",
        "historical",
        "speculative"
      ]
    },
    "difficulty_bucket": {
      "type": "string",
      "enum": ["medium", "hard", "very_hard"]
    },
    "template_id": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "id",
    "story",
    "question",
    "gold_answer",
    "gold_answer_variants",
    "questions",
    "n_hops",
    "setting_family",
    "difficulty_bucket",
    "template_id"
  ]
}
