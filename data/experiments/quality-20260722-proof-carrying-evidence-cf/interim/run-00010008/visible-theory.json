    {
      "channel": "rule_application",
      "formal": "rule:status_weights",
      "id": "f_status_weights",
      "reveal_order": 32,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The panel fixed one shared status scale for the whole inquiry: waking counted as 0; clear counted as 1; latent counted as 2; stable counted as 3; dormant counted as 4; open counted as 5."
    },
    {
      "channel": "rule_application",
      "formal": "rule:checksum_formula",
      "id": "f_checksum_formula",
      "reveal_order": 33,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The local tally began at 14. In order it used relation, temporal, causal, spatial, sequence, and protocol statuses with coefficients 3, 7, 5, 11, 13, 2. At each stream, the panel squared the current tally, added that stream's coefficient times its status value, and kept the remainder modulo 97. It made three passes: first in the stated order, then in reverse order with the coefficients reversed, then once more in the stated order with the coefficient list rotated one place left. Without resetting the tally, it repeated that complete three-pass cycle 123 times."
    },
    {
      "channel": "record",
      "formal": "atom:checksum_key:9",
      "id": "f_checksum_key",
      "reveal_order": 34,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "For this incident, the accepted tally was 9."
    },
    {
      "channel": "rule_application",
      "formal": "rule:final_watch_handover",
      "id": "f_rule_final_watch_handover",
      "reveal_order": 35,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "The final definition was strict: the concordant watchkeeper was the one person whose six-stream tally equaled the accepted tally."
    }
