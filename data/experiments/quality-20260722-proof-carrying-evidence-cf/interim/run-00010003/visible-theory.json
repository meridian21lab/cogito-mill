    {
      "channel": "rule_application",
      "formal": "rule:status_weights",
      "id": "f_status_weights",
      "reveal_order": 32,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The panel fixed one shared status scale for the whole inquiry: stable counted as 0; latent counted as 1; open counted as 2; dormant counted as 3; clear counted as 4; waking counted as 5."
    },
    {
      "channel": "rule_application",
      "formal": "rule:checksum_formula",
      "id": "f_checksum_formula",
      "reveal_order": 33,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The local tally began at 9. In order it used relation, temporal, causal, spatial, sequence, and protocol statuses with coefficients 13, 3, 7, 5, 11, 2. At each stream, the panel squared the current tally, added that stream's coefficient times its status value, and kept the remainder modulo 97. It made three passes: first in the stated order, then in reverse order with the coefficients reversed, then once more in the stated order with the coefficient list rotated one place left. Without resetting the tally, it repeated that complete three-pass cycle 118 times."
    },
    {
      "channel": "record",
      "formal": "atom:checksum_key:2",
      "id": "f_checksum_key",
      "reveal_order": 34,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "For this incident, the accepted tally was 2."
    },
    {
      "channel": "rule_application",
      "formal": "rule:final_workshop_provenance",
      "id": "f_rule_final_workshop_provenance",
      "reveal_order": 35,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "The final definition was strict: the certified restoration lead was the one person whose six-stream tally equaled the accepted tally."
    }
