    {
      "channel": "rule_application",
      "formal": "rule:status_weights",
      "id": "f_status_weights",
      "reveal_order": 32,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The panel fixed one shared status scale for the whole inquiry: dormant counted as 0; latent counted as 1; clear counted as 2; waking counted as 3; stable counted as 4; open counted as 5."
    },
    {
      "channel": "rule_application",
      "formal": "rule:checksum_formula",
      "id": "f_checksum_formula",
      "reveal_order": 33,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The local tally began at 10. In order it used relation, temporal, causal, spatial, sequence, and protocol statuses with coefficients 13, 7, 5, 3, 11, 2. At each stream, the panel squared the current tally, added that stream's coefficient times its status value, and kept the remainder modulo 97. It made three passes: first in the stated order, then in reverse order with the coefficients reversed, then once more in the stated order with the coefficient list rotated one place left. Without resetting the tally, it repeated that complete three-pass cycle 119 times."
    },
    {
      "channel": "record",
      "formal": "atom:checksum_key:36",
      "id": "f_checksum_key",
      "reveal_order": 34,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "For this incident, the accepted tally was 36."
    },
    {
      "channel": "rule_application",
      "formal": "rule:final_workshop_provenance",
      "id": "f_rule_final_workshop_provenance",
      "reveal_order": 35,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "The final definition was strict: the certified restoration lead was the one person whose six-stream tally equaled the accepted tally."
    }
