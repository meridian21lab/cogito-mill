      "formal": "atom:derived_status:relation:p0:clear",
      "id": "f_relation_p0",
      "reveal_order": 2,
      "role": "required",
      "scene_id": "sc2",
      "sentence_ids": [],
      "text": "When the pairing sheet was recovered, Zion Brooks's mentor pennant stood at clear."
