{
  "facts": [
    {
      "channel": "record",
      "formal": "atom:protocol_active",
      "id": "f_protocol_active",
      "reveal_order": 1,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "For this incident, the board declared the concordant watchkeeper protocol active; ordinary rank and reputation did not count."
    },
    {
