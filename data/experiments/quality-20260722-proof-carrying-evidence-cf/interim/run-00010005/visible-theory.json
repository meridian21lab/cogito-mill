    {
      "channel": "rule_application",
      "formal": "rule:status_weights",
      "id": "f_status_weights",
      "reveal_order": 32,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The panel fixed one shared status scale for the whole inquiry: open counted as 0; stable counted as 1; waking counted as 2; dormant counted as 3; latent counted as 4; clear counted as 5."
    },
    {
      "channel": "rule_application",
      "formal": "rule:checksum_formula",
      "id": "f_checksum_formula",
      "reveal_order": 33,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The local tally began at 11. In order it used relation, temporal, causal, spatial, sequence, and protocol statuses with coefficients 7, 11, 3, 5, 2, 13. At each stream, the panel squared the current tally, added that stream's coefficient times its status value, and kept the remainder modulo 97. It made three passes: first in the stated order, then in reverse order with the coefficients reversed, then once more in the stated order with the coefficient list rotated one place left. Without resetting the tally, it repeated that complete three-pass cycle 120 times."
    },
    {
      "channel": "record",
      "formal": "atom:checksum_key:44",
      "id": "f_checksum_key",
      "reveal_order": 34,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "For this incident, the accepted tally was 44."
    },
    {
      "channel": "rule_application",
      "formal": "rule:final_workshop_provenance",
      "id": "f_rule_final_workshop_provenance",
      "reveal_order": 35,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "The final definition was strict: the certified restoration lead was the one person whose six-stream tally equaled the accepted tally."
    }
