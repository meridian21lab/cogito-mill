{
  "facts": [
    {
      "channel": "record",
      "formal": "atom:protocol_active",
      "id": "f_protocol_active",
      "reveal_order": 1,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "For this incident, the board declared the concordant watchkeeper protocol active; ordinary rank and reputation did not count."
    },
    {
      "channel": "record",
      "formal": "atom:derived_status:relation:p0:dormant",
      "id": "f_relation_p0",
      "reveal_order": 2,
      "role": "required",
      "scene_id": "sc2",
      "sentence_ids": [],
      "text": "When the pairing sheet was recovered, Tatum Silva's mentor pennant stood at dormant."
    },
    {
      "channel": "record",
      "formal": "atom:derived_status:relation:p1:latent",
      "id": "f_relation_p1",
      "reveal_order": 3,
      "role": "required",
      "scene_id": "sc3",
      "sentence_ids": [],
      "text": "A witness who checked the roster left Morgan Kline with a latent mentor pennant."
    },
    {
      "channel": "record",
      "formal": "atom:derived_status:relation:p2:open",
      "id": "f_relation_p2",
      "reveal_order": 4,
      "role": "required",
      "scene_id": "sc4",
      "sentence_ids": [],
      "text": "In the earlier pairing note, Tatum Okada carried a open mentor pennant."
