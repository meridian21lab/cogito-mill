    {
      "channel": "rule_application",
      "formal": "rule:status_weights",
      "id": "f_status_weights",
      "reveal_order": 32,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The panel fixed one shared status scale for the whole inquiry: clear counted as 0; open counted as 1; dormant counted as 2; waking counted as 3; stable counted as 4; latent counted as 5."
    },
    {
      "channel": "rule_application",
      "formal": "rule:checksum_formula",
      "id": "f_checksum_formula",
      "reveal_order": 33,
      "role": "required",
      "scene_id": "sc1",
      "sentence_ids": [],
      "text": "The local tally began at 17. In order it used relation, temporal, causal, spatial, sequence, and protocol statuses with coefficients 13, 11, 2, 3, 5, 7. At each stream, the panel squared the current tally, added that stream's coefficient times its status value, and kept the remainder modulo 97. It made three passes: first in the stated order, then in reverse order with the coefficients reversed, then once more in the stated order with the coefficient list rotated one place left. Without resetting the tally, it repeated that complete three-pass cycle 126 times."
    },
    {
      "channel": "record",
      "formal": "atom:checksum_key:4",
      "id": "f_checksum_key",
      "reveal_order": 34,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "For this incident, the accepted tally was 4."
    },
    {
      "channel": "rule_application",
      "formal": "rule:final_watch_handover",
      "id": "f_rule_final_watch_handover",
      "reveal_order": 35,
      "role": "required",
      "scene_id": "sc5",
      "sentence_ids": [],
      "text": "The final definition was strict: the concordant watchkeeper was the one person whose six-stream tally equaled the accepted tally."
    }
  ],
