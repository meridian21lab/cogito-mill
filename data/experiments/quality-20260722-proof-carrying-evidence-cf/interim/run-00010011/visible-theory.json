    {
      "channel": "record",
      "formal": "atom:derived_status:relation:p3:stable",
      "id": "f_relation_p3",
      "reveal_order": 5,
      "role": "required",
      "scene_id": "sc2",
      "sentence_ids": [],
      "text": "Even the damaged roster still marked Eden Okada's mentor pennant as stable."
