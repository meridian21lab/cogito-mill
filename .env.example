# --- Azure OpenAI (custom deployments) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=  # chat / reasoning deployment name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=  # optional

# --- GLM (OpenAI-compatible endpoint; adjust base URL to your provider) ---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.5

# --- Hugging Face Hub (publish under ksopyla/datasets) ---
HF_TOKEN=
HF_DATASET_NAMESPACE=ksopyla

# --- Optional observability ---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=cogito-mill
