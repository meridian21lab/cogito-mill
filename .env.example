# Copy to `.env` and fill in secrets. Never commit `.env`.

# --- Azure OpenAI (one resource, role-specific deployments) ---
AZURE_OPENAI_API_KEY=
# Resource root only — no /openai/... path or query string
AZURE_OPENAI_ENDPOINT=https://agents-patterns-lab-oai.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Cheaper / less capable — story generation
AZURE_OPENAI_WRITER_DEPLOYMENT=gpt-5.6-luna-stories
# Stronger — verification / critique
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-5.6-terra-stories
# Optional
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- GLM via Z.AI Coding Plan (OpenAI-compatible; role-specific model ids) ---
# Docs: https://docs.z.ai/scenario-example/develop-tools/others
# Coding Plan requires this URL; general API https://api.z.ai/api/paas/v4/ is prepaid balance
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
GLM_WRITER_DEPLOYMENT=glm-5.1
GLM_JUDGE_DEPLOYMENT=glm-5.2

# --- Hugging Face Hub ---
HF_TOKEN=
HF_DATASET_NAMESPACE=ksopyla
